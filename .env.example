# Salin ke .env.local lalu isi. Jangan commit .env.local.

# Supabase → Connect → Transaction pooler (port 6543). Dipakai aplikasi (Vercel/serverless).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Supabase → Connect → Session pooler (port 5432). Hanya untuk `pnpm db:migrate`.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Secret key (sb_secret_…) atau service_role lama. RAHASIA: hanya untuk server, jangan diberi prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Nama bucket foto (dibuat oleh `pnpm storage:setup`)
SUPABASE_BUCKET=media
